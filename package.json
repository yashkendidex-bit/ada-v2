{
  "name": "ada-v2",
  "version": "2.0.0",
  "description": "A.D.A V2 - Advanced Design Assistant (GUI: orb interface derived from ethanplusai/jarvis, see NOTICE.md)",
  "private": true,
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5174 && npx electron .\"",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "start": "cross-env NODE_ENV=production npx electron .",
    "prod": "vite build && cross-env NODE_ENV=production npx electron ."
  },
  "license": "SEE NOTICE.md",
  "dependencies": {
    "socket.io-client": "^4.7.4",
    "three": "^0.183.2"
  },
  "devDependencies": {
    "@types/three": "^0.183.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^28.2.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "wait-on": "^7.2.0"
  }
}
